# =========================
# FakePixel Minecraft
# =========================

MC_HOST=mc.fakepixel.me
MC_PORT=25565
MC_VERSION=1.8.9

# Bot account
MC_USERNAME=vmai001

# FakePixel authentication
MC_PASSWORD=vmallu00

# First-time registration command:
# /register vmallu00 vmallu00
#
# Later joins:
# /login vmallu00

# Target island username
TARGET_USERNAME=V_Mallu_Gamer


# =========================
# Web Panel
# =========================

# Railway automatically provides PORT.
# Do not set PORT manually on Railway.

WEB_PORT=8000

# Optional panel authentication
PANEL_USERNAME=vmallu
PANEL_PASSWORD=vmallu


# =========================
# Storage
# =========================

# Railway Volume path.
# For local development you can use ./data
DATA_DIR=./data

SCHEMATICS_DIR=./schematics


# =========================
# Bot
# =========================

BOT_RECONNECT=true
BOT_RECONNECT_DELAY=5000

# Anti-AFK
ANTI_AFK=true

# Automatically enter SkyBlock
AUTO_SKYBLOCK=true

# Automatically visit configured target
AUTO_VISIT=true
